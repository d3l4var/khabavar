[Unit]
Description=KHABAVAR — identity unit (OTP/OIDC/sessions, KH_ROLE=identity)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=khabavar-api
Group=khabavar-api
EnvironmentFile=/etc/khabavar/khabavar-identity.env
Environment=KH_ROLE=identity
ExecStart=/opt/khabavar/bin/khabavar
Restart=always
RestartSec=5
MemoryMax=512M
TasksMax=512
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/khabavar /var/log/khabavar

[Install]
WantedBy=multi-user.target
