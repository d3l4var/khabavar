# /etc/khabavar/khabavar-identity.env — identity unit (OTP, OIDC, sessions)
# Copy to /etc/khabavar/ and chmod 600. Values are NEVER committed (DEP §۵).
# KH_TOKEN_SIGNING_KEY MUST be identical here and in khabavar-api.env: the API hashes
# bearer tokens with it, so a mismatch locks every client out.

KH_ROLE=identity
KH_DB_URL=postgres://app_runtime:CHANGE_ME@localhost:5432/khabavar?sslmode=disable
KH_DB_MAX_OPEN_CONNS=10

KH_TOKEN_SIGNING_KEY=CHANGE_ME
KH_OTP_TTL_SECONDS=120
KH_OTP_MAX_PER_HOUR=5
KH_ACCESS_TOKEN_TTL_SECONDS=900
KH_REFRESH_TOKEN_TTL_SECONDS=2592000
KH_AUTH_CODE_TTL_SECONDS=600
KH_OIDC_ISSUER=https://id.khabavar.ir

KH_SMS_ADAPTER=mock
KH_HTTP_ADDR=:8081
KH_LOG_LEVEL=info
