# /etc/khabavar/khabavar-worker.env — worker unit (outbox, reservation expiry, cleanup)
# Copy to /etc/khabavar/ and chmod 600.

KH_ROLE=worker
KH_DB_URL=postgres://app_runtime:CHANGE_ME@localhost:5432/khabavar?sslmode=disable
KH_DB_MAX_OPEN_CONNS=5

KH_WORKER_INTERVAL_SECONDS=5
KH_WORKER_BATCH_SIZE=100

KH_PAYMENT_ADAPTER=mock
KH_SMS_ADAPTER=mock
KH_LOG_LEVEL=info

# The worker also serves a health endpoint. Without this it would default to :8080 and
# collide with the api unit — the two would fight for the port and one would fail to
# start.
KH_HTTP_ADDR=:8082
