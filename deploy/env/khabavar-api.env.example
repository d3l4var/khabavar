# /etc/khabavar/khabavar-api.env — api unit (catalog, commerce, content, …)
# Copy to /etc/khabavar/ and chmod 600.
# KH_TOKEN_SIGNING_KEY MUST match khabavar-identity.env (bearer verification).

KH_ROLE=api
KH_DB_URL=postgres://app_runtime:CHANGE_ME@localhost:5432/khabavar?sslmode=disable
KH_DB_MAX_OPEN_CONNS=25

KH_TOKEN_SIGNING_KEY=CHANGE_ME

KH_PAYMENT_ADAPTER=mock
KH_STORAGE_ADAPTER=local
KH_STORAGE_LOCAL_ROOT=/var/lib/khabavar/media
KH_CACHE=none

KH_HTTP_ADDR=:8080
KH_LOG_LEVEL=info
