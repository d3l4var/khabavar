# KHABAVAR — env variable names ONLY (DEP §۵: مقادیر هرگز در مخزن)
# این فایل فقط اسلات‌ها را فهرست می‌کند؛ مقادیر واقعی در /etc/khabavar/<unit>.env

# ── نقش باینری (ADR-DB-002 — تک‌باینری، سه unit) ──
KH_ROLE=api            # identity | api | worker

# ── پایگاه داده (نقش app_runtime — Migrations 000010) ──
KH_DB_URL=postgres://app_runtime:CHANGE_ME@localhost:5432/khabavar?sslmode=disable
KH_DB_MAX_OPEN_CONNS=25

# ── هویت / OIDC (CIAM §۳-§۵، IAM §۵) ──
KH_OTP_TTL_SECONDS=120
KH_OTP_MAX_PER_HOUR=5
KH_TOKEN_SIGNING_KEY=CHANGE_ME
KH_ACCESS_TOKEN_TTL_SECONDS=900
KH_REFRESH_TOKEN_TTL_SECONDS=2592000
KH_AUTH_CODE_TTL_SECONDS=600   # عمر کد authorize (OIDC) — پیش‌فرض ۱۰ دقیقه
KH_OIDC_ISSUER=https://id.khabavar.ir   # id_token.iss

# ── Adapterها (همه Mock-first — ADR-ARCH-011) ──
KH_PAYMENT_ADAPTER=mock        # mock | real (پس از انتخاب درگاه ⚠️)
KH_SMS_ADAPTER=mock            # mock | real (پس از انتخاب ⚠️)
# KH_CARRIER_ADAPTER حذف شد: هیچ کدی آن را نمی‌خواند. وقتی آداپتر حامل پیاده شد،
# با config.Load و همین فایل هم‌زمان اضافه شود (اسکریپت scripts/audit-env.py گارد است).
KH_STORAGE_ADAPTER=local       # local | object (پس از انتخاب ⚠️)
KH_STORAGE_LOCAL_ROOT=/var/lib/khabavar/media

# ── worker (outbox) — فقط برای KH_ROLE=worker ──
KH_WORKER_INTERVAL_SECONDS=5
KH_WORKER_BATCH_SIZE=100

# ── کش (اختیاری — تصمیم باز Redis ⚠️) ──
KH_CACHE=none                  # none | redis

# ── HTTP ──
KH_HTTP_ADDR=:8080
KH_LOG_LEVEL=info

# ── آزمون ادغانی (تنها در CI/محلی) ──
# KH_TEST_PG_DSN=postgres://postgres:test@localhost:5432/khabavar?sslmode=disable
