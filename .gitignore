# Go
/bin/
/cover.out
*.test
*.out
vendor/

# Web
node_modules/
web/*/dist/
web/*/.vite/

# Env — رازها هرگز در مخزن (DEP §۵)
.env
*.env
!/deploy/**/*.env.example
!.env.example

# Agent-managed skill library (not part of the project repo)
skills/

# Build artifacts
*.tsbuildinfo
# tsc must never emit next to the design-system sources: Vite resolves .js before
# .tsx, so a stray emitted file would silently shadow the real component.
web/shared/*.js
# verification-only IIFE build (Lightpanda cannot run ES modules)
web/*/dist-lp/
__pycache__/
*.pyc

# Editor / OS
.idea/
.vscode/
.DS_Store
*.swp
